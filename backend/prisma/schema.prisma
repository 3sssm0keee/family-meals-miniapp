model SubscriptionEvent {
  id String @id @default(uuid()) @db.VarChar(64)
  familyId String @db.VarChar(64) @map("family_id")
  memberId String @db.VarChar(64) @map("member_id")
  templateId String @db.VarChar(200) @map("template_id")
  result SubscriptionResult
  recordedAt DateTime @db.DateTime(3) @map("recorded_at")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  family Family @relation("SubscriptionEvent_family", fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member FamilyMember @relation("SubscriptionEvent_member", fields: [familyId, memberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  @@index([familyId, memberId, recordedAt])
  @@map("subscription_event")
}

model Notification {
  id String @id @default(uuid()) @db.VarChar(64)
  familyId String @db.VarChar(64) @map("family_id")
  batchId String @db.VarChar(64) @map("batch_id")
  memberId String @db.VarChar(64) @map("member_id")
  channel NotificationChannel
  status NotificationStatus
  reasonCode String? @db.VarChar(40) @map("reason_code")
  attemptCount Int @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @db.DateTime(3) @map("next_attempt_at")
  sentAt DateTime? @db.DateTime(3) @map("sent_at")
  providerMessageId String? @db.VarChar(200) @map("provider_message_id")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  family Family @relation("Notification_family", fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batch ReviewBatch @relation("Notification_batch", fields: [familyId, batchId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  member FamilyMember @relation("Notification_member", fields: [familyId, memberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([batchId, memberId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification")
}

model IdempotencyRecord {
  id String @id @default(uuid()) @db.VarChar(64)
  userId String @db.VarChar(64) @map("user_id")
  familyId String? @db.VarChar(64) @map("family_id")
  scopeHash String @db.Char(64) @map("scope_hash")
  key String @db.VarChar(128)
  requestHash String @db.Char(64) @map("request_hash")
  status IdempotencyStatus
  httpStatus Int? @map("http_status")
  responseCiphertext Bytes? @db.MediumBlob @map("response_ciphertext")
  expiresAt DateTime @db.DateTime(3) @map("expires_at")
  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.DateTime(3) @map("updated_at")
  family Family? @relation("IdempotencyRecord_family", fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation("IdempotencyRecord_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([userId, scopeHash, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}
