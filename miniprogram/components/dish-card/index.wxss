.dish-card {
  padding: 28rpx;
}
.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.dish-title-box {
  flex: 1;
}
.dish-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C332D;
  margin-bottom: 8rpx;
}
.dish-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.dish-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #EBF1EC;
  flex-shrink: 0;
}
.thumb-img {
  width: 100%;
  height: 100%;
}
.dish-desc {
  font-size: 26rpx;
  color: #747D75;
  margin: 16rpx 0 20rpx 0;
  line-height: 1.4;
}
.variants-container {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.variant-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #F8F6F1;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}
.variant-item.selected {
  background: #FFF5F0;
  border-color: var(--primary, #EE7B57);
}
.variant-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C332D;
}
.variant-portion {
  font-size: 22rpx;
  color: #747D75;
  margin-top: 4rpx;
}
.variant-select-icon {
  font-size: 30rpx;
}
.icon-checked {
  color: var(--primary, #EE7B57);
  font-weight: bold;
}
.icon-unchecked {
  color: #B5BDB6;
}