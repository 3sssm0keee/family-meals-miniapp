.review-card {
  padding: 28rpx;
  min-width: 0;
  box-sizing: border-box;
}
.review-header {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.title-row {
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}
.dish-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C332D;
}
.total-count {
  font-size: 24rpx;
  font-weight: 600;
}
.variant-review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}
.variant-review-block {
  background: #F8F6F1;
  border-radius: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #ECE7DE;
}
.variant-title-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: space-between;
  align-items: center;
}
.v-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C332D;
}
.v-count {
  font-size: 24rpx;
  color: #747D75;
  margin-left: 8rpx;
}
.status-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.participants-box {
  margin: 14rpx 0;
}
.participants-title {
  font-size: 22rpx;
  color: #8C968E;
  margin-bottom: 8rpx;
}
.participant-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.p-chip {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  border: 1rpx solid #E2DCD1;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.p-name {
  font-weight: 600;
  color: #3B453D;
}
.p-note {
  color: #D48B38;
  font-size: 20rpx;
}
.cancel-reason-line {
  font-size: 22rpx;
  color: var(--danger);
  margin-bottom: 12rpx;
}
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #E2DCD1;
}
.quantity-input-box {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}
.q-label {
  font-size: 24rpx;
  color: #555E57;
}
.q-input {
  width: 120rpx;
  height: 60rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--primary, #EE7B57);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary, #EE7B57);
}
.q-unit {
  font-size: 24rpx;
  color: #747D75;
}
.btn-group {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}
.mini-btn {
  margin: 0;
  width: 104rpx !important;
  min-width: 104rpx;
  max-width: 104rpx;
  height: 104rpx;
  min-height: 104rpx;
  flex: 0 0 104rpx;
  box-sizing: border-box;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.4;
  border-radius: 12rpx;
}
.btn-confirm {
  background: var(--primary, #EE7B57);
  color: #FFFFFF;
}
.btn-cancel {
  background: #F3EAE1;
  color: #7B7169;
}
