.cart-bar-container {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 99;
}
.cart-bar {
  background: #2C332D;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(44, 51, 45, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
.cart-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}
.cart-badge-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  background: #5B8266;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}
.cart-num {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #E0A96D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #2C332D;
}
.cart-text {
  display: flex;
  flex-direction: column;
}
.cart-status {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.cart-hint {
  color: #A0A8A1;
  font-size: 20rpx;
}
.submit-btn {
  padding: 18rpx 36rpx !important;
  font-size: 28rpx !important;
  margin: 0 !important;
  border-radius: 24rpx !important;
}