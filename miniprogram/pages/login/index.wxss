.login-page { padding: 24rpx; min-height: 100vh; }
.login-welcome { padding: 48rpx 32rpx; margin-top: 36rpx; }
.login-heading { margin-top: 40rpx; font-size: 38rpx; font-weight: 700; color: #44392f; }
.login-description { margin: 22rpx 0 40rpx; font-size: 27rpx; line-height: 1.8; color: #8f847e; }
.login-action { width: 100%; font-size: 30rpx; line-height: 1.5; padding: 24rpx; }
.user-card { padding: 32rpx; }
.user-info { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; background: #EBF1EC; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.name-row { display: flex; align-items: center; gap: 14rpx; }
.user-name { font-size: 34rpx; font-weight: 700; color: #2C332D; }
.btn-edit-name { font-size: 24rpx; color: #5B8266; font-weight: 600; }
.user-role-badge { font-size: 24rpx; color: #747D75; margin-top: 8rpx; }
.box-title { font-size: 28rpx; font-weight: 700; color: #2C332D; margin-bottom: 16rpx; }
.role-switch-row { display: flex; gap: 16rpx; }
.role-btn { flex: 1; font-size: 26rpx; font-weight: 600; padding: 14rpx; border-radius: 16rpx; background: #F8F6F1; color: #747D75; border: 1rpx solid #E8E3DA; line-height: 1.4; margin: 0; }
.role-btn.active { background: #5B8266; color: #fff; border-color: #5B8266; }
.switch-tip { font-size: 22rpx; color: #8C968E; margin-top: 12rpx; text-align: center; }
.list-title { font-size: 26rpx; font-weight: 700; color: #8C968E; margin-bottom: 12rpx; text-transform: uppercase; }
.menu-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0ECE4; font-size: 28rpx; color: #2C332D; }
.menu-row:last-child { border-bottom: none; }
.arrow { color: #A0A8A1; font-size: 32rpx; }

/* 角色与测试身份卡片样式 */
.member-switcher-box { padding: 24rpx; }
.member-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 12rpx; }
.member-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #FAF8F5; border: 2rpx solid #EAE5DC; border-radius: 18rpx; transition: all 0.2s ease; }
.member-item.active { background: #F0F6F2; border-color: #5B8266; box-shadow: 0 4rpx 12rpx rgba(91, 130, 102, 0.12); }
.member-left { display: flex; align-items: flex-start; gap: 18rpx; flex: 1; }
.member-avatar-box { width: 72rpx; height: 72rpx; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; border: 1rpx solid #E0DDD5; flex-shrink: 0; }
.member-info { flex: 1; }
.member-title-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 6rpx; }
.member-name { font-size: 30rpx; font-weight: 700; color: #2C332D; }
.member-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.tag-admin { background: #EBF1EC; color: #5B8266; border: 1rpx solid #CFDFD3; }
.tag-unsubmitted { background: #FFF4E5; color: #D97706; border: 1rpx solid #FCD34D; }
.tag-member { background: #F3F4F6; color: #4B5563; border: 1rpx solid #E5E7EB; }
.member-status { font-size: 22rpx; color: #5B8266; font-weight: 600; margin-bottom: 4rpx; }
.member-desc { font-size: 20rpx; color: #8C968E; line-height: 1.3; }
.member-action { margin-left: 16rpx; flex-shrink: 0; }
.status-current { font-size: 24rpx; font-weight: 700; color: #5B8266; padding: 8rpx 16rpx; background: #E2ECE5; border-radius: 12rpx; }
.mini-btn-switch { font-size: 24rpx; color: #5B8266; background: #fff; border: 1rpx solid #5B8266; border-radius: 12rpx; padding: 8rpx 20rpx; line-height: 1.4; margin: 0; }

.login-welcome { text-align:center; }
.login-mascot { font-size:100rpx; margin-bottom:32rpx; }
.login-error { color:#BD4D37; margin-top:24rpx; }

.login-divider {display:flex;align-items:center;gap:24rpx;margin:32rpx 0;color:#A29388;font-size:26rpx;}
.login-divider view {flex:1;height:1rpx;background:#EADDD3;}
.invite-choice {width:100%;min-height:88rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #EE7B57;border-radius:48rpx;color:#C65A37;background:#FFF5ED;font-size:30rpx;}
.invite-login-form {margin-top:28rpx;}
.login-input {text-align:left;box-sizing:border-box;height:96rpx;padding:0 24rpx;background:#FFF5ED;border-radius:18rpx;margin-bottom:20rpx;font-size:27rpx;}
