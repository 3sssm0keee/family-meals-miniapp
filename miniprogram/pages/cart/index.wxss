.cart-page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 顶部品牌栏 */
.brand-top-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.mascot-badge {
  font-size: 48rpx;
  margin-right: 12rpx;
}
.brand-logo-text-group {
  display: flex;
  flex-direction: column;
}
.brand-logo-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2D2B2A;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
.brand-logo-sub {
  font-size: 20rpx;
  color: #8E827A;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

/* 2. 暖橙主横幅 (我的选择) */
.tobacco-banner {
  background: linear-gradient(135deg, #F07C56 0%, #EE6F47 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(238, 123, 87, 0.28);
  margin-bottom: 24rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.banner-content {
  flex: 1;
}
.banner-main-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.banner-subtitle {
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}
.banner-illus-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}
.illus-bubble {
  background: #FFFFFF;
  color: #EE7B57;
  font-size: 18rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.illus-bowl-wrap {
  width: 90rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.illus-bowl-face {
  font-size: 48rpx;
}

/* 3. 已选菜品列表 (对标图 5) */
.cart-section {
  margin-bottom: 24rpx;
}
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.cart-item-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(184, 150, 126, 0.08);
  border: 1rpx solid #F3EBE2;
}
.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 18rpx;
  background: #F7EFE8;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #2D2B2A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-variant-chip {
  display: inline-block;
  font-size: 20rpx;
  color: #EE7B57;
  background: #FFF2ED;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.item-portion {
  font-size: 20rpx;
  color: #9A8E85;
  margin-top: 8rpx;
}

/* 垃圾桶与步进器操作栏 (对标图 5) */
.item-right-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  margin-left: 16rpx;
}
.btn-del-trash {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0EB;
  border-radius: 12rpx;
}
.trash-icon {
  font-size: 24rpx;
}
.stepper-box {
  display: flex;
  align-items: center;
  background: #FAF5F0;
  border: 1rpx solid #EBDED3;
  border-radius: 24rpx;
  padding: 2rpx 6rpx;
}
.stepper-btn {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #5A4D45;
}
.stepper-val {
  min-width: 36rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2B2A;
}

/* 4. 治愈插画小金句卡片 (对标图 5) */
.warm-quote-box {
  background: #FFF6EE;
  border: 1rpx dashed #F8D5C2;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin: 24rpx 0;
  text-align: center;
}
.quote-text {
  font-size: 22rpx;
  color: #B3684B;
  line-height: 1.4;
  font-weight: 600;
}

/* 5. 备注输入区 */
.note-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(184, 150, 126, 0.06);
  border: 1rpx solid #F3EBE2;
  margin-bottom: 30rpx;
}
.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.note-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D2B2A;
}
.note-char-count {
  font-size: 20rpx;
  color: #A69B92;
}
.note-textarea {
  width: 100%;
  height: 140rpx;
  background: #FAF6F1;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #2D2B2A;
  box-sizing: border-box;
  border: 1rpx solid #EBE2D8;
}

/* 6. 底部提交大按钮 (对标图 5) */
.cart-bottom-cta {
  margin: 10rpx 0 24rpx;
}
.btn-submit-menu {
  width: 100% !important;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 1.3;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #F07C56 0%, #EE6F47 100%);
  color: #FFFFFF;
  border-radius: 46rpx;
  box-shadow: 0 10rpx 28rpx rgba(238, 123, 87, 0.35);
  text-align: center;
}

/* 空购物车状态 */
.empty-cart-state {
  text-align: center;
  padding: 100rpx 40rpx;
}
.empty-cart-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.empty-cart-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2D2B2A;
}
.empty-cart-sub {
  font-size: 22rpx;
  color: #9A8E85;
  margin: 12rpx 0 36rpx;
}
.btn-empty-go {
  width: 280rpx !important;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: #EE7B57;
  color: #FFFFFF;
  border-radius: 38rpx;
  margin: 0 auto;
  display: block;
}

/* 底部治愈金句 */
.doodle-footer-quote {
  text-align: center;
  font-size: 22rpx;
  color: #B0A298;
  margin: 30rpx 0 20rpx;
  letter-spacing: 2rpx;
}
