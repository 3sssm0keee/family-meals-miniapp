.dishes-page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 顶部品牌栏 */
.brand-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.mascot-badge {
  font-size: 48rpx;
  margin-right: 12rpx;
}
.brand-logo-text-group {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.brand-logo-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2D2B2A;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
.brand-logo-sub {
  font-size: 20rpx;
  color: #8E827A;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}
.btn-new-dish {
  font-size: 22rpx;
  color: #EE7B57;
  background: #FFEFEA;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #F8D8CE;
  font-weight: 700;
}

/* 2. 暖橙主横幅 (菜品库) */
.tobacco-banner {
  background: linear-gradient(135deg, #F07C56 0%, #EE6F47 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(238, 123, 87, 0.28);
  margin-bottom: 24rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.banner-content {
  flex: 1;
}
.banner-main-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.banner-subtitle {
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}
.banner-illus-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}
.illus-bubble {
  background: #FFFFFF;
  color: #EE7B57;
  font-size: 18rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.illus-bowl-wrap {
  width: 90rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.illus-bowl-face {
  font-size: 48rpx;
}

/* 3. 搜索栏 (对标图 4) */
.search-bar-wrap {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-input-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #EBDED3;
  border-radius: 36rpx;
  padding: 10rpx 22rpx;
  height: 68rpx;
  box-sizing: border-box;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #A69B92;
}
.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #2D2B2A;
}
.search-clear {
  font-size: 28rpx;
  color: #A69B92;
  padding: 0 8rpx;
}
.btn-search {
  padding: 0 32rpx !important;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx !important;
  font-weight: 700;
  background: #EE7B57 !important;
  color: #FFFFFF !important;
  border-radius: 34rpx;
  margin: 0 !important;
  box-shadow: 0 4rpx 14rpx rgba(238, 123, 87, 0.25);
}

/* 4. 分类标签滑块 (全部 / 家常菜 / 素菜 / 汤羹 / 下饭菜) */
.category-chips-scroll {
  white-space: nowrap;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 4rpx 0;
}
.chip-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  height: 64rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  line-height: 1.3;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6E625A;
  background: #FFFFFF;
  border: 1rpx solid #EBDED3;
  transition: all 0.2s;
  flex-shrink: 0;
}
.chip-item.active {
  background: #EE7B57;
  color: #FFFFFF;
  border-color: #EE7B57;
  box-shadow: 0 4rpx 12rpx rgba(238, 123, 87, 0.25);
}

/* 5. 3列美食卡片网格 (对标图 4) */
.dishes-grid-container {
  margin-bottom: 24rpx;
}
.dishes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.dish-grid-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(184, 150, 126, 0.07);
  border: 1rpx solid #F3EBE2;
  display: flex;
  flex-direction: column;
}
.dish-card-img-wrap {
  position: relative;
  width: 100%;
  height: 160rpx;
  background: #F7EFE8;
}
.dish-grid-img {
  width: 100%;
  height: 100%;
}
.dish-top-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: #EE7B57;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.dish-temp-tag {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: #FF9800;
  color: #FFFFFF;
  font-size: 16rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.dish-grid-info {
  padding: 12rpx 12rpx 16rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: space-between;
}
.dish-grid-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2B2A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-grid-variants-info {
  font-size: 18rpx;
  color: #9A8E85;
  margin-bottom: 12rpx;
}
.dish-grid-action-row {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.btn-card-select {
  width: 100% !important;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 22rpx !important;
  font-weight: 700;
  background: #EE7B57 !important;
  color: #FFFFFF !important;
  border-radius: 25rpx;
  padding: 0 !important;
  box-shadow: 0 4rpx 10rpx rgba(238, 123, 87, 0.2);
}
.btn-card-edit {
  width: 100% !important;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 20rpx !important;
  font-weight: 600;
  background: #FFF2ED !important;
  color: #EE7B57 !important;
  border-radius: 22rpx;
  padding: 0 !important;
  border: 1rpx solid #F8D8CE;
  margin: 0 !important;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A423D;
}
.empty-sub {
  font-size: 22rpx;
  color: #9A8E85;
  margin-top: 8rpx;
}

/* 6. 底部手绘治愈金句 */
.doodle-footer-quote {
  text-align: center;
  font-size: 22rpx;
  color: #B0A298;
  margin: 32rpx 0 30rpx;
  letter-spacing: 2rpx;
}

/* 7. 规格选择与加入浮层 (对标图 2 & 3) */
.variant-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.variant-modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 0 32rpx 48rpx;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
  position: relative;
  animation: slideUp 0.25s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-hero-wrap {
  position: relative;
  width: calc(100% + 64rpx);
  margin-left: -32rpx;
  height: 320rpx;
  background: #F5EEE6;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
}
.modal-hero-img {
  width: 100%;
  height: 100%;
}
.modal-close-btn {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-bubble-quote {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  background: #FFFFFF;
  color: #EE7B57;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.modal-dish-header {
  margin: 24rpx 0 20rpx;
}
.modal-dish-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.modal-dish-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D2B2A;
}
.modal-brand-tag {
  font-size: 20rpx;
  color: #EE7B57;
  font-weight: 600;
  background: #FFF2ED;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.modal-dish-desc {
  font-size: 22rpx;
  color: #8A7E77;
  margin-top: 8rpx;
  line-height: 1.4;
}
.variant-select-section {
  margin-top: 24rpx;
}
.variant-select-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.variant-title-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D2B2A;
}
.variant-title-sub {
  font-size: 20rpx;
  color: #A69B92;
}
.variants-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 6rpx 2rpx;
}
.variant-card-item {
  flex: 1;
  min-width: 170rpx;
  border: 2rpx solid #EFE6DC;
  border-radius: 20rpx;
  padding: 18rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  background: #FAF7F2;
  transition: all 0.2s;
}
.variant-card-item.selected {
  border-color: #EE7B57;
  background: #FFF5F0;
  box-shadow: 0 4rpx 14rpx rgba(238, 123, 87, 0.18);
}
.variant-radio-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid #D5C8BD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
}
.variant-card-item.selected .variant-radio-badge {
  background: #EE7B57;
  border-color: #EE7B57;
}
.variant-bowl-emoji {
  font-size: 38rpx;
  margin-bottom: 8rpx;
}
.variant-item-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2B2A;
  margin-bottom: 4rpx;
  text-align: center;
}
.variant-item-portion {
  font-size: 18rpx;
  color: #8C8078;
  text-align: center;
}
.modal-note-section {
  margin: 24rpx 0;
  background: #FAF6F2;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #F0E6DC;
}
.note-section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A423D;
  margin-bottom: 12rpx;
}
.note-sub {
  font-size: 20rpx;
  color: #A89D95;
  font-weight: normal;
}
.note-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid #EBE0D5;
}
.note-input {
  flex: 1;
  font-size: 22rpx;
  color: #2D2B2A;
}
.note-clear {
  font-size: 28rpx;
  color: #A69B92;
  padding: 0 8rpx;
}
.modal-bottom-btn-box {
  margin-top: 28rpx;
  text-align: center;
}
.btn-modal-add {
  width: 100% !important;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 1.3;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #F07C56 0%, #EE6F47 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(238, 123, 87, 0.32);
}
.modal-footer-slogan {
  font-size: 20rpx;
  color: #B0A298;
  margin-top: 18rpx;
}

.modal-note-section textarea.note-input { width: 100%; height: 110rpx; min-height: 110rpx; padding: 12rpx 0; box-sizing: border-box; }
