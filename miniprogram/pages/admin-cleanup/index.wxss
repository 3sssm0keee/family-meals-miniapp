.cleanup-page { padding: 24rpx; min-height: 100vh; box-sizing: border-box; }
.cleanup-header { padding: 24rpx; border-radius: 20rpx; }
.cleanup-title { font-size: 32rpx; font-weight: 700; color: #2c332d; }
.cleanup-subtitle { margin-top: 8rpx; color: #747d75; font-size: 23rpx; }
.history-cleanup { margin: 24rpx 0; padding: 24rpx; background: #fff; border-radius: 20rpx; }
.cleanup-page button { box-sizing: border-box; max-width: 100%; min-width: 0; font-family: inherit; }
.history-cleanup > button { width: 100%; font-size: 24rpx; }
.history-candidate button { width: 100%; margin: 12rpx 0; font-size: 24rpx; }
.history-note { color: #665f59; font-size: 23rpx; line-height: 1.5; margin: 16rpx 0; }
.history-candidate { border-top: 1rpx solid #eee; padding: 18rpx 0; font-size: 25rpx; }
.history-candidate view + view { color: #777; font-size: 22rpx; margin-top: 6rpx; }
.history-error { color: #b64035; }
.delete-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1100; padding: 24rpx; background: rgba(35,35,35,.48); display: flex; align-items: center; justify-content: center; }
.delete-card { width: 100%; max-width: 660rpx; max-height: 80vh; overflow-y: auto; padding: 32rpx; border-radius: 26rpx; background: #fff; box-sizing: border-box; }
.delete-title { font-size: 31rpx; font-weight: 700; }
.delete-detail { margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; }
.delete-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.delete-actions button { flex: 1; min-width: 0; font-size: 24rpx; }
.delete-cancel { color: #b64035; background: #fff0ef; }
.delete-confirm { color: #267249; background: #e8f6ed; }

/* Reuse the app's warm card palette, keeping maintenance rows compact. */
.cleanup-header { border-radius: 32rpx; text-align: center; }
.cleanup-title, .candidate-title { color: var(--text-main); }
.cleanup-subtitle, .history-note, .candidate-meta, .candidate-id { color: var(--text-sub); }
.history-cleanup { padding: 0; background: transparent; }
.cleanup-page button { width: auto; margin: 12rpx 0; padding: 14rpx 24rpx; height: auto; line-height: 1.5; border-radius: 28rpx; font-size: 24rpx; font-weight: 600; background: var(--primary-light); color: var(--primary); }
.cleanup-page button::after { border: none; }
.cleanup-page button[disabled] { background: var(--primary-light); color: var(--primary); opacity: .5; }
.cleanup-page .history-cleanup > button { width: 100%; }
.history-note { padding: 0 8rpx; }
.cleanup-toolbar { padding: 20rpx; margin-bottom: 20rpx; border-radius: 28rpx; background: var(--bg-card); border: 1rpx solid var(--border); }
.cleanup-toolbar button { width: 100%; }
.history-candidate { margin: 18rpx 0; padding: 24rpx; border: 1rpx solid var(--border); border-radius: 28rpx; background: var(--bg-card); box-shadow: 0 6rpx 20rpx rgba(214,175,155,.08); overflow-wrap: anywhere; }
.history-candidate.candidate-selected { border-color: var(--primary); }
.history-candidate .candidate-title { font-size: 28rpx; font-weight: 600; }
.history-candidate .candidate-meta, .history-candidate .candidate-id { font-size: 22rpx; line-height: 1.5; margin-top: 8rpx; }
.candidate-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.cleanup-page .candidate-actions button { flex: 1; width: 0; margin: 0; }
.cleanup-page button.cleanup-primary { background: var(--primary); color: white; }
.cleanup-page .delete-actions button { width: 0; }
.cleanup-page button.delete-cancel { color: #b64035; background: #fff0ef; }
.cleanup-page button.delete-confirm { color: #267249; background: #e8f6ed; }
.cleanup-header .cleanup-title { display: inline-block; padding: 12rpx 24rpx; border-radius: 24rpx; background: var(--primary-light); color: var(--primary); font-size: 28rpx; font-weight: 600; }
.file-summary { display: flex; align-items: center; gap: 20rpx; }
.file-thumbnail { flex: none; width: 112rpx; height: 112rpx; border-radius: 20rpx; background: var(--primary-light); }
.thumbnail-empty { display: flex; align-items: center; justify-content: center; padding: 12rpx; text-align: center; color: var(--text-muted); font-size: 20rpx; }
.file-info { flex: 1; min-width: 0; }
